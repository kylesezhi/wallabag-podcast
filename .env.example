# Wallabag (OAuth password grant)
WALLABAG_URL=https://app.wallabag.it
WALLABAG_CLIENT_ID=your_client_id_here
WALLABAG_CLIENT_SECRET=your_client_secret_here
WALLABAG_USERNAME=your_username_here
WALLABAG_PASSWORD=your_password_here

# Kokoro-FastAPI
KOKORO_BASE_URL=http://localhost:8880
KOKORO_DEFAULT_VOICE=bm_daniel
KOKORO_SPEED=1.0
KOKORO_RESPONSE_FORMAT=mp3
KOKORO_MAX_CHUNK_CHARS=2000         # max chars per TTS request; longer text is split into streamed chunks

# App
BASE_URL=http://localhost:8000     # reachable address for enclosure URLs; set to LAN IP for phone
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
EXCLUDE_TAGS=computer,interactive  # comma-separated; client-side filtered (Wallabag API only AND-includes)
MIN_TEXT_CHARS=200                 # skip articles whose cleaned text is shorter
MAX_FETCH_PAGES=50                # safety cap when enumerating unread candidates
EPISODE_GAP_SECONDS=3             # seconds of silence appended to each episode's end (floored to whole seconds, 0 disables)
FEED_TITLE=Kyle's Morning Drive
LOG_LEVEL=INFO                     # DEBUG/INFO/WARNING/ERROR; rotating log file written to DATA_DIR/logs/
PRONUNCIATIONS=JSON=Jason,SQL=sequel  # comma-separated KEY=SPOKEN pairs; whole-word, case-insensitive rewrites before TTS
